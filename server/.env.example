# ===================================================
# Forma Backend Environment Variables (Template)
# Copy this file to .env and configure your values.
# ===================================================

# Port where Express server will listen
PORT=5000

# Node execution environment (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
# In Vite development, this is typically http://localhost:5173 or http://localhost:5174
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Example for Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/forma
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/forma?retryWrites=true&w=majority
