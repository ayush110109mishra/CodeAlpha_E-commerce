# ===================================================
# Forma Backend Environment Variables (Template)
# Copy this file to .env and configure your values.
# ===================================================

# Port where Express server will listen
PORT=5000

# Node execution environment (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
# In local Vite development: http://localhost:5173
# In production: Your deployed Vercel frontend URL, e.g. https://your-forma-store.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Note for Atlas: If password has reserved characters (@, #, %, :), our sanitizer encodes them automatically.
# Example for MongoDB Atlas (+srv):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/test?retryWrites=true&w=majority&authSource=admin
# Example for MongoDB Atlas (standard replica set):
# MONGODB_URI=mongodb://<db_username>:<db_password>@ac-xxx-shard-00-00.mongodb.net:27017,ac-xxx-shard-00-01.mongodb.net:27017,ac-xxx-shard-00-02.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/test?retryWrites=true&w=majority&authSource=admin
